{
  "name": "noahprail-website",
  "version": "2.0.0",
  "description": "Noah Prail's personal website built with Eleventy and Tailwind CSS",
  "scripts": {
    "clean": "rm -rf _site",
    "dev": "npm-run-all clean --parallel dev:*",
    "dev:eleventy": "eleventy --serve --quiet",
    "dev:css": "postcss src/styles/tailwind.css --o _site/styles/main.css --watch",
    "build": "npm-run-all clean build:css build:eleventy",
    "build:eleventy": "eleventy",
    "build:css": "NODE_ENV=production postcss src/styles/tailwind.css --o _site/styles/main.css"
  },
  "keywords": ["eleventy", "tailwindcss", "portfolio"],
  "author": "Noah Prail",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "autoprefixer": "^10.4.16",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.0"
  }
}
