---
layout: base.njk
---
<article class="max-w-3xl mx-auto px-6 py-24">
  <header class="mb-14">
    <a href="/blog/" class="text-xs uppercase tracking-[0.2em] text-neutral-500 hover:text-neutral-300 transition-colors inline-flex items-center gap-2 mb-8">&larr; Blog</a>
    <p class="text-xs text-neutral-500 uppercase tracking-widest mb-4">{{ displayDate }}</p>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tighter leading-tight">{{ title }}</h1>
  </header>
  <div class="prose prose-invert prose-lg max-w-none">
    {{ content | safe }}
  </div>
</article>
