<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body class="min-h-screen bg-neutral-950 text-neutral-100 font-sans antialiased">
  <header class="fixed top-0 left-0 right-0 z-50 bg-neutral-950/80 backdrop-blur-md border-b border-neutral-800/60">
    <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="text-base font-semibold tracking-tight hover:text-neutral-300 transition-colors">Noah Prail</a>
      <ul class="flex items-center gap-1 text-sm text-neutral-400">
        <li class="relative group">
          <button class="flex items-center gap-1 px-3 py-1.5 rounded-md hover:text-neutral-100 hover:bg-neutral-800/60 transition-colors focus:outline-none">
            Work
            <svg class="w-3.5 h-3.5 opacity-60 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <ul class="absolute left-0 top-full mt-1 w-44 py-1 bg-neutral-900 border border-neutral-800 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 translate-y-1 group-hover:translate-y-0">
            <li><a href="/work/" class="block px-4 py-2 hover:bg-neutral-800 hover:text-neutral-100 transition-colors rounded-md mx-1">All Work</a></li>
            <li class="mx-1 my-1 border-t border-neutral-800"></li>
            <li><a href="/work/photography/" class="block px-4 py-2 hover:bg-neutral-800 hover:text-neutral-100 transition-colors rounded-md mx-1">Photography</a></li>
            <li><a href="/work/videography/" class="block px-4 py-2 hover:bg-neutral-800 hover:text-neutral-100 transition-colors rounded-md mx-1">Videography</a></li>
            <li><a href="/work/rockets/" class="block px-4 py-2 hover:bg-neutral-800 hover:text-neutral-100 transition-colors rounded-md mx-1">Rockets</a></li>
          </ul>
        </li>
        <li><a href="/blog/" class="block px-3 py-1.5 rounded-md hover:text-neutral-100 hover:bg-neutral-800/60 transition-colors">Blog</a></li>
        <li><a href="/about/" class="block px-3 py-1.5 rounded-md hover:text-neutral-100 hover:bg-neutral-800/60 transition-colors">About</a></li>
        <li><a href="/contact/" class="block px-3 py-1.5 rounded-md hover:text-neutral-100 hover:bg-neutral-800/60 transition-colors">Contact</a></li>
      </ul>
    </nav>
  </header>
  <main class="pt-16">
    {{ content | safe }}
  </main>
  <footer class="border-t border-neutral-800/60 mt-24 py-12">
    <div class="max-w-6xl mx-auto px-6 flex flex-col items-center gap-6">
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-neutral-500">
        <a href="{{ social.github }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-200 transition-colors">GitHub</a>
        <a href="{{ social.gitlab }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-200 transition-colors">GitLab</a>
        <a href="{{ social.instagram }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-200 transition-colors">Instagram</a>
        <a href="{{ social.youtube }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-200 transition-colors">YouTube</a>
        <a href="{{ social.twitter }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-200 transition-colors">Twitter</a>
        <a href="{{ social.linkedin }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-200 transition-colors">LinkedIn</a>
        <a href="{{ social.stackoverflow }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-200 transition-colors">Stack Overflow</a>
        <a href="{{ social.medium }}" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-200 transition-colors">Medium</a>
      </div>
      <p class="text-xs text-neutral-600">&copy; 2025 Noah Prail</p>
    </div>
  </footer>
</body>
</html>
