---
layout: base.njk
title: Videography
---
<section class="max-w-6xl mx-auto px-6 py-24">
  <div class="flex items-baseline justify-between mb-12">
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-neutral-500 mb-3">Work</p>
      <h1 class="text-5xl md:text-6xl font-bold tracking-tighter">Videography</h1>
    </div>
    <a href="{{ social.youtube }}" target="_blank" rel="noopener noreferrer" class="text-sm text-neutral-400 hover:text-neutral-100 transition-colors shrink-0 ml-6">YouTube &rarr;</a>
  </div>
  <p class="text-neutral-500 mb-14">You can find more of my videos on YouTube.</p>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {% for video in videography %}
    <a href="{{ video.url }}" target="_blank" rel="noopener noreferrer" class="group block bg-neutral-900 rounded-lg overflow-hidden hover:bg-neutral-800/80 transition-colors">
      <div class="aspect-video overflow-hidden">
        <img src="{{ video.thumbnail }}" alt="{{ video.title }}" class="w-full h-full object-cover rounded-[inherit] opacity-70 group-hover:opacity-90 group-hover:scale-105 transition-all duration-500" loading="lazy">
      </div>
      <div class="p-5">
        <h2 class="font-semibold mb-2 group-hover:text-neutral-200 transition-colors leading-snug">{{ video.title }}</h2>
        {% if video.description %}
        <p class="text-sm text-neutral-500 leading-relaxed">{{ video.description }}</p>
        {% endif %}
      </div>
    </a>
    {% endfor %}
  </div>
</section>
