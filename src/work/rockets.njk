---
layout: base.njk
title: Rockets
---
<section class="max-w-6xl mx-auto px-6 py-24">
  <h1 class="text-5xl font-bold tracking-tight mb-16">Rockets</h1>
  <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4">
    {% for rocket in rockets %}
    <figure class="break-inside-avoid">
      {% if rocket.link %}
      <a href="{{ rocket.link }}" target="_blank" rel="noopener noreferrer">
        <img src="{{ rocket.url }}" alt="{{ rocket.alt }}" class="w-full rounded-sm" loading="lazy">
      </a>
      {% else %}
      <img src="{{ rocket.url }}" alt="{{ rocket.alt }}" class="w-full rounded-sm" loading="lazy">
      {% endif %}
      {% if rocket.caption %}
      <figcaption class="mt-2 text-sm text-neutral-500 text-center">{{ rocket.caption }}</figcaption>
      {% endif %}
    </figure>
    {% endfor %}
  </div>
</section>
